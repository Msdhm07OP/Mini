# EventSync 2.0 Environment Configuration

# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# PostgreSQL / Supabase Configuration
# Leave blank until you configure a real PostgreSQL database.
# Local PostgreSQL example:
# DATABASE_URL=postgresql://username:password@localhost:5432/eventsync
# Supabase example (after the project is created):
# DATABASE_URL=postgresql://postgres:<PASSWORD>@db.<PROJECT-REF>.supabase.co:5432/postgres
DATABASE_URL=
# Use DB_SSL=false only for a local PostgreSQL instance without TLS.
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# Supabase Auth (required in production; optional local-demo mode when not configured)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# auto = require bearer auth when Supabase values are set; required = always require Auth;
# local = explicitly bypass auth for local demos only (blocked in production).
AUTH_MODE=auto
# sql_rpc = execute writes with Supabase Postgres RPC functions; javascript = existing Node transaction engine.
# Keep javascript for local PostgreSQL until the Supabase migrations are applied.
BOOKING_ENGINE=javascript

# Database Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=10000

# Application Security
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Concurrency Control
BOOKING_LOCK_TIMEOUT_MS=15000
BOOKING_MAX_RETRIES=3
BOOKING_RETRY_DELAY_MS=100

# Idempotency
IDEMPOTENCY_KEY_EXPIRY_HOURS=24

# Testing
# Configure only for isolated tests; destructive/concurrency scripts refuse to run without it.
TEST_DATABASE_URL=
